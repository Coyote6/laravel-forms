{
    "name": "coyote6/laravel-forms",
    "description": "Generate the html for forms and assist with the validation process in Laravel with optional Livewire/Flux integration.",
    "type": "library",
    "keywords": ["laravel","forms","validation","html","livewire", "flux", "tailwind"],
    "homepage": "https://coyote6.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Tanner Naeher",
            "email": "tanner@coyote6.com",
            "homepage": "https://coyote6.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Coyote6\\LaravelForms\\": "src/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coyote6\\LaravelForms\\Providers\\FormServiceProvider"
            ],
            "aliases": {
                "Form": "Coyote6\\LaravelForms\\Facades\\Support\\FormHelper"
            }
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    }
}